<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Zyga.SeriRestClient</PackageId>
    <RootNamespace>Zyga.SeriRestClient</RootNamespace>
    <Description>A logging-enhanced REST client that wraps RestSharp with Serilog logging capabilities</Description>
    <PackageTags>rest;http;client;serilog;logging;restsharp</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Enable only after 1.0.0 is published: the baseline must reference a version that
    actually exists on nuget.org.

  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  -->

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="RestSharp" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

</Project>
